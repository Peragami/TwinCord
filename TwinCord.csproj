<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.10.0</Version>
    <ApplicationIcon>TwinCord.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 単一exe配布のときは同梱物を圧縮してサイズを抑える(初回起動がやや遅くなる)
       圧縮は自己完結発行でのみサポートされる(NETSDK1176)ため、自己完結のときだけ有効にする -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- CPUと引き換えにGCヒープを圧縮する(0-9)。ホスト側(WPF)のメモリ削減 -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- アプリ内の「変更履歴」はREADMEの該当節をそのまま表示する(二重管理を避けるため埋め込む) -->
    <EmbeddedResource Include="README.md" LogicalName="TwinCord.README.md" />
  </ItemGroup>

</Project>
