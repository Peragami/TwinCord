<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows 11 SDKでビルドしつつ、実行時の最低サポートをWindows 10 2004(19041)にする。
         READMEの「Windows 10 / 11」と宣言を一致させる。 -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.11.3</Version>
    <ApplicationIcon>TwinCord.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 配布はフォルダ構成なので、使わない多言語リソースを同梱しない(フォルダを見やすく、zipを軽く)。
         日本語と英語だけ残す(それ以外の言語のフレームワークメッセージは英語にフォールバック) -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 単一exe配布のときは同梱物を圧縮してサイズを抑える(初回起動がやや遅くなる)
       圧縮は自己完結発行でのみサポートされる(NETSDK1176)ため、自己完結のときだけ有効にする -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 同梱物をexe内に保持せず、%TEMP%\.net\TwinCord\<ハッシュ>\ へ展開してから読み込む。
         圧縮した単一exeのままだと読み込んだアセンブリがプライベートメモリに載り続け、
         ホスト側(WPF)のメモリが170MB前後まで膨らむ(展開方式なら90MB前後)。
         代償は初回起動時だけ展開の分(数秒)遅くなること。古い展開フォルダは
         起動時にBundleCleanupが削除する。exeのサイズはほぼ変わらない -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- CPUと引き換えにGCヒープを圧縮する(0-9)。ホスト側(WPF)のメモリ削減 -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- アプリ内の「変更履歴」は docs/changelog.md の該当節をそのまま表示する(二重管理を避けるため埋め込む) -->
    <EmbeddedResource Include="docs\changelog.md" LogicalName="TwinCord.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- テストプロジェクトはアプリの既定Compile/Noneに含めない -->
    <Compile Remove="TwinCord.Tests\**\*.cs" />
    <None Remove="TwinCord.Tests\**\*" />
  </ItemGroup>

</Project>
