<Window x:Class="TwinCord.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="アップデート" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#313338" Foreground="#DBDEE1">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DiscordStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="新しいバージョンがあります" FontSize="20" FontWeight="Bold" Foreground="White" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Background="#2B2D31" CornerRadius="10" Padding="10,3">
                    <TextBlock x:Name="CurrentText" Text="現在:" Foreground="#B5BAC1" FontSize="12" />
                </Border>
                <TextBlock Text="→" Foreground="#949BA4" FontSize="14" VerticalAlignment="Center" Margin="8,0" />
                <Border Background="#5865F2" CornerRadius="10" Padding="10,3">
                    <TextBlock x:Name="LatestText" Text="最新:" Foreground="White" FontSize="12" FontWeight="Bold" />
                </Border>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource InfoCard}" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" Foreground="#DBDEE1" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Value="0"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource ResultText}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="LaterButton" Content="後で" MinWidth="96"
                    Style="{StaticResource BtnText}" IsCancel="True" Click="LaterButton_Click" />
            <Button x:Name="UpdateButton" Content="今すぐ更新" MinWidth="120" Margin="8,0,0,0"
                    Style="{StaticResource BtnPrimary}" IsDefault="True" Click="UpdateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
