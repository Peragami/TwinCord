<Window x:Class="TwinCord.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="設定" Height="600" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="580" MinHeight="480"
        Background="#313338" Foreground="#DBDEE1">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DiscordStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Style="{StaticResource SidebarTabs}">
            <TabItem Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="起動と常駐" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Windows起動時に自動開始" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="PCへのサインイン時に自動で起動します" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="StartBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="閉じる・最小化でトレイに格納" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="×ボタンでも終了せず常駐します(通知用アイコンは常時表示)" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TrayBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="起動時に最小化で開始" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="起動直後からトレイに格納します" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="StartMinBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>

                    <TextBlock Text="通知とバッジ" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="非表示アカウントの未読バッジを表示" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="OFFでも通知の監視自体は継続します" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="BadgeBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="未読チャンネルもバッジに含める" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="メンション以外の未読チャンネルも件数に含めます" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="UnreadBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="応答停止時に自動再読み込み" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="応答が停止したタブだけ自動で再読み込みします" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ReloadBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>

                    <TextBlock Text="更新" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="起動時に更新を自動確認" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="新しいバージョンがあれば通知します" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="UpdateCheckBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>

                    <TextBlock Text="メモリ" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="メモリ節約モード" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="2アカウントで1つのブラウザ/GPUを共有します(次回起動から)。初回は再ログインが必要になる場合があります" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="MemorySavingBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>

                    <TextBlock Text="設定の持ち運び" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="ExportButton" Content="エクスポート" Style="{StaticResource BtnSecondary}" Click="ExportButton_Click" />
                        <Button x:Name="ImportButton" Content="インポート" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0" Click="ImportButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TransferResult" Style="{StaticResource ResultText}" />

                    <TextBlock Text="通知テスト" Style="{StaticResource SectionHeader}" />
                    <Button x:Name="TestNotifyButton" Content="テスト通知を送る"
                            Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="TestNotifyButton_Click" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="通知">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TwinCordの通知" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="TwinCordの通知を表示" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="OFFではバルーンも履歴記録も行いません" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="NotifyBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="表示中のアカウントの通知は出さない" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="見ている最中のアカウントの通知を抑えます" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="SkipViewedBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <Border Style="{StaticResource DiscordDivider}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="最小化・格納中のみ通知する" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="ウィンドウ表示中は通知を出しません" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="HiddenOnlyBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                    <TextBlock Text="Discord側の通知設定（サーバー毎・チャンネル毎）はDiscord内で行ってください。ここではTwinCordが出す通知全体を制御します。" Style="{StaticResource RowHint}" Margin="0,12,0,0" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="表示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="拡大率" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border Background="#1E1F22" CornerRadius="10" Padding="10,3" Margin="0,0,12,0"
                                        DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="Zoom1Value" Text="100%" Foreground="White"
                                               FontSize="12" FontWeight="Bold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Acc1 の拡大率" Style="{StaticResource RowLabel}" />
                                    <Slider x:Name="Zoom1Slider" Style="{StaticResource DiscordSlider}"
                                            Minimum="0.5" Maximum="2.0" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Margin="0,10,0,2"
                                            ValueChanged="ZoomSlider_Changed" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border Background="#1E1F22" CornerRadius="10" Padding="10,3" Margin="0,0,12,0"
                                        DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="Zoom2Value" Text="100%" Foreground="White"
                                               FontSize="12" FontWeight="Bold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Acc2 の拡大率" Style="{StaticResource RowLabel}" />
                                    <Slider x:Name="Zoom2Slider" Style="{StaticResource DiscordSlider}"
                                            Minimum="0.5" Maximum="2.0" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" Margin="0,10,0,2"
                                            ValueChanged="ZoomSlider_Changed" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="50%〜200%の範囲で5%刻み。" Style="{StaticResource RowHint}" Margin="0,8,0,0" />
                    <TextBlock Text="Discord表示" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="ダウンロードボタンを隠す" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="サーバーリストの「アプリをダウンロード」を隠します(再読み込み後に反映)" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="HideDlBox" Style="{StaticResource DiscordToggle}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="アプリについて">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TwinCord" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#5865F2" CornerRadius="10" Padding="10,3">
                            <TextBlock x:Name="VersionText" Text="バージョン:" Foreground="White"
                                       FontSize="12" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="2アカウント同時常駐の軽量Discordラッパー" TextWrapping="Wrap"
                               Margin="0,8,0,0" Style="{StaticResource RowLabel}" />

                    <TextBlock Text="環境" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="起動ファイル" Style="{StaticResource RowHint}" Margin="0" />
                            <TextBlock x:Name="ExeText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="データフォルダ" Style="{StaticResource RowHint}" Margin="0" />
                            <TextBlock x:Name="DataText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock Text="WebView2ランタイム" Style="{StaticResource RowHint}" Margin="0" />
                            <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BANされにくい理由" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource InfoCard}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#DBDEE1" Text="・表示しているのはDiscord公式Web版そのもので、改造・チート機能はありません。&#x0a;・トークンの抜き出しや非公開APIの直接利用はしていません。通常のブラウザとほぼ同じ見え方です。&#x0a;・自動送信や大量操作などの自動化機能は搭載していません。&#x0a;&#x0a;ただし100%の保証はできません。規約上は公式クライアントの利用が前提のため、理論上のリスクはゼロではありません。自動化・マクロ・スパム行為の併用は避けてください。" />
                    </Border>

                    <TextBlock Text="変更履歴" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource InfoCard}">
                        <TextBlock x:Name="HistoryText" TextWrapping="Wrap" FontSize="11" Foreground="#B5BAC1" />
                    </Border>

                    <TextBlock Text="自己診断" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="DiagButton" Content="今すぐ診断する"
                                Style="{StaticResource BtnSecondary}" Click="DiagButton_Click" />
                        <Button x:Name="DiagCopyButton" Content="コピー" MinWidth="80" Margin="8,0,0,0"
                                Style="{StaticResource BtnSecondary}" IsEnabled="False" Click="DiagCopyButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DiagResult" Style="{StaticResource ResultText}"
                               FontFamily="Consolas,MeiryoKeGothic" />

                    <TextBlock Text="更新" Style="{StaticResource SectionHeader}" />
                    <Button x:Name="UpdateButton" Content="更新を確認"
                            Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="UpdateButton_Click" />
                    <TextBlock x:Name="UpdateResult" Style="{StaticResource ResultText}" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Background="#2B2D31" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" MinWidth="96" Style="{StaticResource BtnText}" IsCancel="True" />
                <Button Content="保存" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
