<Window x:Class="TwinCord.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="通知履歴" Height="440" Width="560"
        WindowStartupLocation="CenterScreen" MinWidth="420" MinHeight="300"
        Background="#313338" Foreground="#DBDEE1">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DiscordStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="#2B2D31" />
                <Setter Property="Foreground" Value="#DBDEE1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35373C" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#404249" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="通知履歴" FontSize="20" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="ダブルクリックで該当アカウントに移動します" FontSize="12" Foreground="#B5BAC1" Margin="0,4,0,0" />
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="HistoryList" MouseDoubleClick="HistoryList_DoubleClick"
                 Background="Transparent" Foreground="#DBDEE1" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <Button Grid.Row="2" Content="閉じる" MinWidth="96" HorizontalAlignment="Right"
                Margin="0,12,0,0" Style="{StaticResource BtnPrimary}" IsCancel="True" Click="CloseButton_Click" />
    </Grid>
</Window>
