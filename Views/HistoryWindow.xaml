<Window x:Class="TwinCord.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="通知履歴" Height="400" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#2B2D31" Foreground="#DBDEE1">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" x:Name="HistoryList" MouseDoubleClick="HistoryList_DoubleClick"
                 Background="#1E1F22" Foreground="#DBDEE1" BorderThickness="0" />
        <Button Grid.Row="1" Content="閉じる" Width="80" HorizontalAlignment="Right"
                Margin="0,8,0,0" IsCancel="True" />
    </Grid>
</Window>
